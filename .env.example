# Copy to .env.local (local) or your host's environment settings (production). Never commit real values.

# ---------------------------------------------------------------------------
# Supabase  (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the site, used to build links in emails (revised-quote links, admin links, driver invitations).
# LOCAL: http://localhost:3000.  PRODUCTION: https://vantatransportation.com (no trailing slash). It is baked in at BUILD time,
# so set it in the host's environment settings and redeploy. Driver invitations ignore a localhost value on the live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA time zone in which customers' pickup dates/times are interpreted.
BUSINESS_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Google Maps  (required for the fare calculator)
# ---------------------------------------------------------------------------
# SERVER key: enable "Routes API" and "Places API (New)". Never exposed to the browser.
GOOGLE_MAPS_SERVER_API_KEY=
# BROWSER key: enable "Maps JavaScript API" (route map) and, optionally, "Maps Embed API" (contact page map).
# Restrict it by HTTP referrer to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email via Brevo (SERVER ONLY; never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Create an API key in Brevo (SMTP & API > API keys). Never commit a real key.
BREVO_API_KEY=
# MUST be a sender (or a domain) you have verified in Brevo. Do not assume a Gmail address is verified.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vanta Transportation
# Where new-booking / inquiry / quote alerts are delivered. Defaults to the business email if left blank.
BUSINESS_NOTIFICATION_EMAIL=vantaholdings.1@gmail.com

# ---------------------------------------------------------------------------
# Cloudinary: vehicle photos (admin uploads, signed on the server)
# ---------------------------------------------------------------------------
# From the Cloudinary console (Dashboard). The cloud name and API key are public identifiers; the secret is SERVER ONLY.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used to sign uploads and delete unused images.
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Stripe: card payments (Visa, Mastercard, American Express) through Stripe's hosted Checkout. SERVER ONLY.
# Nothing is offered to customers until an admin switches online payment on AND these are set.
# Hosted Checkout needs no publishable key, so none is read by this project.
# ---------------------------------------------------------------------------
# Test keys (sk_test_...) in development; live keys (sk_live_...) only in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Endpoint URL: https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayPal (official JavaScript SDK in the browser, orders created and captured on the server)
# ---------------------------------------------------------------------------
# From developer.paypal.com > Apps & Credentials. The client id is public (it is passed to PayPal's button script);
# the client secret is SERVER ONLY. Never prefix any of these with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for real payments. Anything else is treated as sandbox.
PAYPAL_ENV=sandbox
# Id of the webhook you create in PayPal for https://YOUR-DOMAIN/api/paypal/webhook (used to verify notifications).
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Vanta support (helpline) phone: OPTIONAL fallback only.
# The number shown on the "Call Vanta Support" buttons comes first from the admin setting Website content > contact.phone.
# This variable is used only when that setting is empty. If neither is set, no call button is shown and the admin dashboard warns.
# ---------------------------------------------------------------------------
HELPLINE_PHONE=
